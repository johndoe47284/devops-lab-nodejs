    {
      "name": "Dashboard (DEVOPS-15)",
      "item": [
        {
          "name": "GET global dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Has task stats and one line per project\", function () {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.tasks).to.have.keys(\"total\", \"byStatus\", \"overdue\", \"completionRate\");",
                  "  pm.expect(d.perProject).to.be.an(\"array\");",
                  "});"
