    {
      "name": "Project tasks (DEVOPS-12)",
      "item": [
        {
          "name": "POST a task in the project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const task = pm.response.json();",
                  "pm.test(\"Task belongs to the project and starts in todo\", function () {",
                  "  pm.expect(task.projectId).to.eql(pm.collectionVariables.get(\"projectId\"));",
                  "  pm.expect(task.status).to.eql(\"todo\");",
                  "});",
                  "pm.collectionVariables.set(\"taskId\", task.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write Postman tests\",\n  \"description\": \"One request per route\",\n  \"assignee\": \"Matthias\",\n  \"dueDate\": \"2026-12-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET tasks filtered by status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Every task has status todo\", function () {",
                  "  const tasks = pm.response.json();",
                  "  pm.expect(tasks).to.be.an(\"array\").that.is.not.empty;",
                  "  tasks.forEach(t => pm.expect(t.status).to.eql(\"todo\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks?status=todo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "todo"
                }
              ]
            }
          }
        },
        {
          "name": "GET tasks searched with q",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Search finds the created task\", function () {",
                  "  const ids = pm.response.json().map(t => t.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get(\"taskId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks?q=postman",
              "host": [
                "{{baseUrl}}"
